#!/usr/bin/env bash
set -euo pipefail

start_dir="${1:-$PWD}"
outer_session="${2:-}"
outer_client="${3:-}"

# Must be running inside tmux (popup is still inside tmux)
tmux display-message -p '' >/dev/null 2>&1 || {
  echo "tmux-float: must be run from inside tmux" >&2
  exit 1
}

if [[ -z "$outer_session" ]]; then
  # Fallback: whatever session the client is on *right now* (usually outer)
  outer_session="$(tmux display-message -p '#S')"
fi

float_session="_float_${outer_session}"

# Ensure float session exists
if ! tmux has-session -t "$float_session" 2>/dev/null; then
  tmux new-session -d -s "$float_session" -c "$start_dir"
fi

# Session-scoped links
tmux set-option -t "$float_session" @is_floating 1
tmux set-option -t "$float_session" @outer_name "$outer_session"
tmux set-option -t "$outer_session" @float_name "$float_session"
tmux set-option -t "$float_session" @outer_client "$outer_client"

# Attach the popup client to the float session
exec tmux attach-session -t "$float_session"
