#!/usr/bin/env bash
set -uo pipefail

exclude="${1:-}"

target="$(
  tmux list-sessions -F '#{session_name}:#{session_last_attached}' |
    awk -F: -v ex="$exclude" '
      $1 == "" { next }
      $1 ~ /^_float_/ { next }
      ex != "" && $1 == ex { next }
      { print }
    ' |
    sort -t: -k2,2nr |
    head -n1 |
    cut -d: -f1
)"

if [[ -z "${target:-}" ]]; then
  exit 1
fi

tmux switch-client -t "$target"
