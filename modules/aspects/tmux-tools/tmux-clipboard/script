#!/bin/sh
set -eu

tmp="$(mktemp -t tmux-clipboard.XXXXXX)"
trap 'rm -f "$tmp"' EXIT HUP INT TERM

cat > "$tmp"
[ -s "$tmp" ] || exit 0

have() { command -v "$1" >/dev/null 2>&1; }

# Wayland (native Linux or WSLg)
if [ -n "${WAYLAND_DISPLAY:-}" ] && have wl-copy; then
    wl-copy < "$tmp"
    exit 0
fi

# X11
if [ -n "${DISPLAY:-}" ] && have xclip; then
    xclip -selection clipboard < "$tmp"
    exit 0
fi

# macOS
if have pbcopy; then
    pbcopy < "$tmp"
    exit 0
fi

# WSL → Windows clipboard via clip.exe
# Detect WSL by /proc/version containing "Microsoft"
if grep -qi microsoft /proc/version 2>/dev/null && have clip.exe; then
    clip.exe < "$tmp"
    exit 0
fi

# Fallback: do nothing (tmux buffer still gets saved)
exit 0
